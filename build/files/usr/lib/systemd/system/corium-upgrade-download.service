[Unit]
Description=Stage a Corium upgrade without rebooting
Documentation=https://github.com/Corium-OS/Corium

# Nothing to do without a network, and no point racing the boot.
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot

# Plain `bootc upgrade` fetches and stages the new image, then stops. The node
# keeps running what it booted; the reboot stays the operator's decision, but
# becomes near-instant because the work is already done.
#
# Deliberately not --download-only. That flag stages the deployment locked, so
# the operator's eventual reboot would come back up on the old image and the
# download would be garbage-collected -- the opposite of what this policy
# promises. --download-only belongs in the apply path, which unlocks it itself
# after draining.
ExecStart=/usr/bin/bootc upgrade --quiet

# A registry being unreachable is not a failure worth alerting on: the timer
# will come round again.
SuccessExitStatus=0
Restart=no

StandardOutput=journal
StandardError=journal
