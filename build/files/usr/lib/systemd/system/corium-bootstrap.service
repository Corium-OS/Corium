[Unit]
Description=Corium node bootstrap
Documentation=https://github.com/qjoly/corium

# The agent reads the `corium:` block from the cloud-config document that
# cloud-init has already fetched and merged, so it must run after cloud-init has
# finished. Running earlier would mean parsing a document that may still be
# incomplete.
After=cloud-final.service network-online.target
Wants=network-online.target
Requires=cloud-final.service

# Bootstrapping is a first-boot concern. The agent is idempotent and exits early
# on an already-bootstrapped node, but not starting at all is cheaper and makes
# the intent legible in `systemctl list-units`.
ConditionPathExists=!/var/lib/corium/bootstrapped

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/corium-agent bootstrap

# A failed bootstrap is not retried indefinitely. A node that half-joined a
# cluster and keeps retrying is worse than a node that stopped and said why:
# the journal holds the reason, and the operator decides what happens next.
Restart=no

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
